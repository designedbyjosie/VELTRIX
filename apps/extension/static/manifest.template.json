{
  "manifest_version": 3,
  "name": "VELTRIX — Financial Intelligence",
  "short_name": "VELTRIX",
  "version": "0.1.0",
  "description": "Understand the money side of any page: product prices against your history and budget, tickers in the news, travel costs against your trip budget.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Analyze this page with VELTRIX",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["__API_ORIGIN__/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
