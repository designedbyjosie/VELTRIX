{
  "name": "@veltrix/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "prisma generate && next dev -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -p 3000",
    "typecheck": "prisma generate >/dev/null && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma generate && tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@prisma/client": "6.19.3",
    "@veltrix/shared": "0.1.0",
    "bcryptjs": "3.0.3",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "next": "15.5.27",
    "nodemailer": "10.0.16",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "2.15.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.18",
    "@types/jsdom": "21.1.7",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.27",
    "jsdom": "26.1.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.1.18",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
