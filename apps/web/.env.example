# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://veltrix:veltrix@localhost:5432/veltrix?schema=public"
# Public origin of the web app. Used for CSRF origin checks; the extension must be built for the same origin.
APP_URL="http://localhost:3000"

# ─── Optional: security & operations ───────────────────────────────────────
# bcrypt work factor (default 12).
# BCRYPT_COST=12
# Secret for POST /api/jobs/run (scheduled alerts + insights). At least 16 characters.
# CRON_SECRET=""
# Separate database for `npm test` (defaults to the veltrix_test database below).
# TEST_DATABASE_URL="postgresql://veltrix:veltrix@localhost:5432/veltrix_test?schema=public"
# Demo user password used by `npm run db:seed` (default veltrix-demo-2026).
# SEED_DEMO_PASSWORD=""

# ─── Optional: AI advisor ──────────────────────────────────────────────────
# "anthropic", "openai" (any OpenAI-compatible /chat/completions endpoint) or "none".
# Without a key, the advisor uses VELTRIX's built-in deterministic analysis.
AI_PROVIDER="none"
# AI_API_KEY=""
# Model id. Anthropic defaults to claude-opus-5-5; required for "openai".
# AI_MODEL=""
# Base URL override (OpenAI-compatible providers, proxies).
# AI_BASE_URL=""
# Advisor messages per user per 24h (default 100).
# AI_DAILY_MESSAGE_LIMIT=100

# ─── Optional: market data ─────────────────────────────────────────────────
# "demo" (simulated, clearly labeled) or "alphavantage".
MARKET_DATA_PROVIDER="demo"
# ALPHA_VANTAGE_API_KEY=""

# ─── Optional: currency conversion ─────────────────────────────────────────
# "none" or "frankfurter" (ECB reference rates — check the provider's terms before commercial use).
FX_PROVIDER="none"

# ─── Not yet implemented: interfaces reserved for these integrations ───────
# AGGREGATOR_PROVIDER=""   # e.g. plaid — bank connections via the provider's official consent flow
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# NEWS_PROVIDER=""
# NEWS_API_KEY=""
# PRICE_FEED_PROVIDER=""
# TRAVEL_PROVIDER=""
