# ─── Required ──────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://veltrix:veltrix@localhost:5432/veltrix?schema=public"
# Public origin of the web app. Used for CSRF origin checks; the extension must be built for the same origin.
APP_URL="http://localhost:3000"

# 32-byte key that encrypts bank-connection tokens and 2FA secrets at rest.
# Generate one with:  openssl rand -base64 32
# Required in production; keep it secret and never change it once accounts have linked banks or 2FA.
ENCRYPTION_KEY=""

# ─── Email (verification, password reset, security alerts) ─────────────────
# For Gmail, iCloud, Outlook or Yahoo you only need SMTP_USER and SMTP_PASS (an app password):
# the server and sender are filled in from the address. Any other SMTP provider also needs SMTP_HOST.
# Don't wrap values in quotes in a hosting dashboard (they're stripped anyway).
# Without SMTP in development, emails are printed to the terminal running `npm run dev`.
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# EMAIL_FROM="VELTRIX <you@example.com>"
# Set to "false" to let unverified accounts in (not recommended for a public site).
# REQUIRE_EMAIL_VERIFICATION=true

# ─── Optional: security & operations ───────────────────────────────────────
# bcrypt work factor (default 12).
# BCRYPT_COST=12
# Secret for POST /api/jobs/run (alerts, insights, bank sync). At least 16 characters.
# CRON_SECRET=""
# Separate database for `npm test` (defaults to the veltrix_test database below).
# TEST_DATABASE_URL="postgresql://veltrix:veltrix@localhost:5432/veltrix_test?schema=public"

# ─── Optional: AI advisor ──────────────────────────────────────────────────
# "anthropic", "openai" (any OpenAI-compatible /chat/completions endpoint) or "none".
# Without a key, the advisor uses VELTRIX's built-in deterministic analysis.
AI_PROVIDER="none"
# AI_API_KEY=""
# Model id. Anthropic defaults to claude-opus-5-5; required for "openai".
# AI_MODEL=""
# Base URL override (OpenAI-compatible providers, proxies).
# AI_BASE_URL=""
# Advisor messages per user per 24h (default 100).
# AI_DAILY_MESSAGE_LIMIT=100

# ─── Market data (real stock prices and company news) ──────────────────────
# Free key at https://finnhub.io/register. With a key set, Finnhub is used automatically.
# Without one, prices are shown as unavailable (nothing is simulated).
# FINNHUB_API_KEY=""
# Optional: Alpha Vantage fills in price history when Finnhub's plan doesn't include candles.
# ALPHA_VANTAGE_API_KEY=""
# Override: "finnhub", "alphavantage", "none", or "demo" (simulated, labeled; for testing only).
# MARKET_DATA_PROVIDER=""

# ─── Currency conversion ───────────────────────────────────────────────────
# "frankfurter" (default; free European Central Bank reference rates, no key) or "none".
# FX_PROVIDER="frankfurter"

# ─── Bank connections (Plaid) ──────────────────────────────────────────────
# Keys from https://dashboard.plaid.com/developers/keys. Sandbox is free and uses test banks
# (username user_good / password pass_good). Production needs Plaid's approval.
# PLAID_CLIENT_ID=""
# PLAID_SECRET=""
# PLAID_ENV="sandbox"
# PLAID_COUNTRY_CODES="US"
